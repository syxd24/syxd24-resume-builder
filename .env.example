# Copy this file to .env.local, fill the values, then run `npm run env:check`.
# Connection metadata is read only by trusted server code in this project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the modern Supabase secret key (or legacy service role only if necessary).
# NEVER expose this as NEXT_PUBLIC_* and never commit a real value.
SUPABASE_SECRET_KEY=

# Optional app-level protection for a private deployment if implemented.
# Keep server-side only.
APP_ACCESS_SECRET=

# Used by server/PDF routines where an absolute origin is required.
APP_URL=http://localhost:3000

# Optional Vercel Deployment Protection automation bypass used only by the
# server-side PDF browser when it opens the private print route.
VERCEL_AUTOMATION_BYPASS_SECRET=
