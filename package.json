{
  "name": "personal-resume-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "env:check": "node scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "npm run env:check && playwright test --grep @live",
    "test:visual": "playwright test --config tests/visual-pdf/playwright.config.ts",
    "test:pdf": "playwright test --config tests/visual-pdf/playwright.config.ts --grep \"generated PDFs\""
  },
  "dependencies": {
    "@sparticuz/chromium": "140.0.0",
    "@supabase/supabase-js": "2.57.4",
    "mammoth": "1.12.3",
    "next": "16.3.6",
    "pdf-parse": "1.1.1",
    "playwright-core": "1.55.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.7.2",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "27.0.1",
    "jszip": "3.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
